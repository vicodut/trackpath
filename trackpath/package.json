{
  "name": "at",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:nest\" \"npm:dev:client\"",
    "dev:nest": "nest start --watch",
    "dev:client": "vite",
    "build": "vite build && node_modules/.bin/nest build",
    "start": "NODE_ENV=production node dist/server/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed:gps": "tsx scripts/seed-gps.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "fetch:highlights": "tsx scripts/fetch-highlights.ts",
    "fetch:elevations": "tsx scripts/fetch-elevations.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit"
  },
  "description": "Appalachian Trail hike tracker with Garmin inReach integration",
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "better-auth": "^1.5.6",
    "compression": "^1.8.1",
    "dompurify": "^3.3.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.21.0",
    "vaul": "^1.1.2",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.18",
    "@nestjs/schematics": "^11.0.10",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.24",
    "@types/compression": "^1.8.1",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^6.0.1",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3"
  }
}
