{
  "name": "trackpath-root",
  "private": true,
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "npm run start --workspace=@trackpath/api",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "test": "turbo test",
    "migrate": "npm run migrate --workspace=@trackpath/db",
    "db:generate": "npm run db:generate --workspace=@trackpath/db",
    "db:migrate": "npm run db:migrate --workspace=@trackpath/db",
    "db:studio": "npm run db:studio --workspace=@trackpath/db"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "turbo": "^2.5.4"
  }
}
