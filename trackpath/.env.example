# PostgreSQL connection string (required)
DATABASE_URL=postgres://username:password@localhost:5432/path_tracker

# Better Auth — session signing secret (required, generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Base URL for auth callbacks (defaults to http://localhost:3001)
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated list of admin emails allowed to write (leave empty to allow any signed-in user)
ADMIN_EMAILS=

# GitHub OAuth login (https://github.com/settings/developers) — login disabled without these
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Garmin inReach MapShare ID (from share.garmin.com/YourShareName) — enables Garmin sync
MAPSHARE_ID=

# Garmin auto-sync interval in minutes (default: 5)
POLL_INTERVAL_MIN=5

# Strava OAuth (https://www.strava.com/settings/api) — enables Strava sync
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Ghost CMS instance backing the blog proxy (optional)
GHOST_URL=
GHOST_CONTENT_API_KEY=

# API port for local dev (default: 3001). Railway sets PORT in production instead.
NEST_PORT=3001
